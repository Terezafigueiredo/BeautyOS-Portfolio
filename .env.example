# Configuração do Supabase para o BeautyOS.
# Copie este arquivo para ".env" (que já está no .gitignore) e
# preencha com os valores do seu projeto em Supabase > Project Settings > API.
#
# NUNCA coloque a "service_role key" aqui nem em nenhum arquivo do frontend —
# ela ignora o Row Level Security e deve existir apenas em ambiente de servidor.

# URL do projeto (Project Settings > API > Project URL)
VITE_SUPABASE_URL=

# Chave pública "publishable" (Project Settings > API > Project API keys > publishable)
VITE_SUPABASE_PUBLISHABLE_KEY=
